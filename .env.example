# Address the ZonaryOS backend HTTP server binds to.
ZONARYOS_HTTP_ADDR=:8080

# Port 5433, not Postgres's default 5432: `make dev-up`'s docker-compose.yml
# runs Postgres with `network_mode: host`, and a real deploy target turned
# out to already run its own native Postgres on 5432 - since host networking
# means Docker can't just remap the port, the container's Postgres itself
# listens on 5433 instead (see docker-compose.yml and docs/DEVELOPMENT.md's
# "Running the full stack in containers" section). If you're instead using
# `make dev-up-standalone` (a real natively-running Postgres, no container),
# use 5432 in every URL below.

# Used by `make migrate` (cmd/migrate): a privileged/owner DSN, able to
# create tables, roles, and RLS policies. Never used by the running server.
ZONARYOS_MIGRATE_DATABASE_URL=postgres://zonaryos:zonaryos@localhost:5433/zonaryos?sslmode=disable

# Used by the RLS integration tests (internal/platform/db). Same as above:
# an owner DSN for setup/teardown, and the unprivileged zonaryos_app role
# DSN that RLS policies actually apply to.
ZONARYOS_TEST_ADMIN_DATABASE_URL=postgres://zonaryos:zonaryos@localhost:5433/zonaryos?sslmode=disable
ZONARYOS_TEST_APP_DATABASE_URL=postgres://zonaryos_app:zonaryos_app@localhost:5433/zonaryos?sslmode=disable

# Used by the running server (cmd/server): the unprivileged zonaryos_app
# DSN - RLS actually applies to this role. Never the migrate/admin DSN above.
ZONARYOS_DATABASE_URL=postgres://zonaryos_app:zonaryos_app@localhost:5433/zonaryos?sslmode=disable

# ZonaryOS Keycloak realm (see docker-compose.yml / deploy/keycloak). The
# backend discovers the realm's JWKS endpoint from the issuer URL to
# verify bearer tokens - see internal/identity.
ZONARYOS_OIDC_ISSUER_URL=http://localhost:8081/realms/zonaryos
ZONARYOS_OIDC_CLIENT_ID=zonaryos-web

# internal/platformadmin's hardcoded allowlist: comma-separated emails
# permitted to read the cross-firm, platform-metadata-only view at
# GET /api/platform-admin/firms and /platform-admin. Empty (unset) by
# default - nobody is a platform admin until this is explicitly set.
# ZONARYOS_PLATFORM_ADMIN_EMAILS=admin@zonaryos.com

# internal/license's license verification (Open Points item 32) - all
# OPTIONAL and OFF by default. Only ZONARYOS_LICENSE_ENFORCEMENT=true
# (exact match) turns enforcement on; unset (or any other value) leaves
# every existing code path completely unaffected - see
# docs/DEVELOPMENT.md's "License Verification" section before setting any
# of these. Generate a test keypair/token with `go run ./cmd/licensegen`.
# ZONARYOS_LICENSE_ENFORCEMENT=true
# ZONARYOS_LICENSE_PUBLIC_KEY=<base64url Ed25519 public key from `cmd/licensegen -genkey`>
# ZONARYOS_LICENSE_TOKEN=<token string from `cmd/licensegen`>
# ZONARYOS_LICENSE_GRACE_PERIOD=72h

# internal/edgeagent's optional NATS JetStream bridge (NATS JetStream/
# Edge Agent completion batch) - OFF by default. Unset means the direct
# HTTP push path (POST /api/edge/events) is the only ingestion path, same
# as before this batch existed. Only set this if you have a real NATS
# server (with JetStream enabled) reachable at this URL.
# ZONARYOS_NATS_URL=nats://localhost:4222
# ZONARYOS_NATS_POLL_INTERVAL=5s

# Server infrastructure hardening (same batch) - request timeout and
# request body size limits, all optional with sensible defaults.
# ZONARYOS_REQUEST_TIMEOUT=30s
# ZONARYOS_MAX_JSON_BODY_BYTES=1048576
# ZONARYOS_MAX_UPLOAD_BODY_BYTES=10485760

# Used by the live-Keycloak identity integration test
# (internal/identity/keycloak_integration_test.go). Requires `make dev-up`.
ZONARYOS_TEST_KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/zonaryos
ZONARYOS_TEST_KEYCLOAK_CLIENT_ID=zonaryos-web
ZONARYOS_TEST_KEYCLOAK_USERNAME=dev@zonaryos.local
ZONARYOS_TEST_KEYCLOAK_PASSWORD=zonaryos-dev
