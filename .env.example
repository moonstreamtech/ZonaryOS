# Address the ZonaryOS backend HTTP server binds to.
ZONARYOS_HTTP_ADDR=:8080

# Used by `make migrate` (cmd/migrate): a privileged/owner DSN, able to
# create tables, roles, and RLS policies. Never used by the running server.
ZONARYOS_MIGRATE_DATABASE_URL=postgres://zonaryos:zonaryos@localhost:5432/zonaryos?sslmode=disable

# Used by the RLS integration tests (internal/platform/db). Same as above:
# an owner DSN for setup/teardown, and the unprivileged zonaryos_app role
# DSN that RLS policies actually apply to.
ZONARYOS_TEST_ADMIN_DATABASE_URL=postgres://zonaryos:zonaryos@localhost:5432/zonaryos?sslmode=disable
ZONARYOS_TEST_APP_DATABASE_URL=postgres://zonaryos_app:zonaryos_app@localhost:5432/zonaryos?sslmode=disable

# Used by the running server (cmd/server): the unprivileged zonaryos_app
# DSN - RLS actually applies to this role. Never the migrate/admin DSN above.
ZONARYOS_DATABASE_URL=postgres://zonaryos_app:zonaryos_app@localhost:5432/zonaryos?sslmode=disable

# ZonaryOS Keycloak realm (see docker-compose.yml / deploy/keycloak). The
# backend discovers the realm's JWKS endpoint from the issuer URL to
# verify bearer tokens - see internal/identity.
ZONARYOS_OIDC_ISSUER_URL=http://localhost:8081/realms/zonaryos
ZONARYOS_OIDC_CLIENT_ID=zonaryos-web

# Used by the live-Keycloak identity integration test
# (internal/identity/keycloak_integration_test.go). Requires `make dev-up`.
ZONARYOS_TEST_KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/zonaryos
ZONARYOS_TEST_KEYCLOAK_CLIENT_ID=zonaryos-web
ZONARYOS_TEST_KEYCLOAK_USERNAME=dev@zonaryos.local
ZONARYOS_TEST_KEYCLOAK_PASSWORD=zonaryos-dev
