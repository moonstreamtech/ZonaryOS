# Base URL the frontend's server-side code (API route handlers, server
# components) uses to call the ZonaryOS backend - see src/lib/*.ts.
ZONARYOS_API_BASE_URL=http://localhost:8080

# ZonaryOS Keycloak realm (see ../docker-compose.yml / ../deploy/keycloak).
# Used both to build the browser-facing login redirect
# (src/app/api/auth/login) and for the server-side authorization-code ->
# token exchange (src/app/api/auth/callback) - both must resolve to the
# same reachable address the browser used, since Keycloak's `start-dev`
# mode derives each issued token's `iss` claim from the request that
# minted it (see docker-compose.yml's own comment on this).
ZONARYOS_KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/zonaryos
ZONARYOS_KEYCLOAK_CLIENT_ID=zonaryos-web

# Usage telemetry (Open Points item 40) - aggregate, non-content counts
# only (page/feature-usage counts, request/source-IP counts on the Go
# backend). Default-off: leave both unset/false unless this installation
# has explicitly decided to opt in - see internal/telemetry and
# lib/telemetry.ts's doc comments for the exact default-disabled
# guarantee, and docs/OPEN_POINTS.md's KVKK cross-reference for the
# open legal question this intersects with.
#
# ZONARYOS_TELEMETRY_ENABLED (server-side, this Next.js process's own
# API routes - lib/telemetryServer.ts, api/telemetry/route.ts) and
# NEXT_PUBLIC_ZONARYOS_TELEMETRY_ENABLED (browser-bundle-visible,
# lib/telemetry.ts) are deliberately two separate flags, not one -
# NEXT_PUBLIC_ vars are inlined into the client bundle at build time, so
# only a build-time-safe value belongs there; the server-only flag is
# read at request time and never shipped to the browser. Set BOTH to
# "true" to fully enable telemetry for this installation; setting only
# one leaves the other half off.
ZONARYOS_TELEMETRY_ENABLED=false
NEXT_PUBLIC_ZONARYOS_TELEMETRY_ENABLED=false
